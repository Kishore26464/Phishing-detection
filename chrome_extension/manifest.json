{
  "manifest_version": 3,
  "name": "PhishGuard AI — Phishing & Malware Detector",
  "short_name": "PhishGuard",
  "version": "1.0.0",
  "description": "AI-powered real-time phishing and malware detection. Scans URLs, detects fake login forms, and warns you about dangerous websites.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "notifications",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PhishGuard AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["utils/api.js", "utils/urlAnalyzer.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
